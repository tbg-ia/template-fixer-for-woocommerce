{
    "name": "template-fixer/woocommerce-template-fixer",
    "description": "Automatically detects and fixes outdated WooCommerce template overrides in any WordPress theme",
    "type": "wordpress-plugin",
    "keywords": ["wordpress", "woocommerce", "templates", "theme", "compatibility"],
    "homepage": "https://github.com/your-username/template-fixer-for-woocommerce",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Your Name",
            "email": "your-email@example.com",
            "homepage": "https://your-website.com"
        }
    ],
    "support": {
        "issues": "https://github.com/your-username/template-fixer-for-woocommerce/issues",
        "source": "https://github.com/your-username/template-fixer-for-woocommerce"
    },
    "require": {
        "php": ">=7.4",
        "composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^9.0",
        "yoast/phpunit-polyfills": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "installer-name": "template-fixer-for-woocommerce"
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "security": "psalm --taint-analysis",
        "check-all": [
            "@lint",
            "@test",
            "@security"
        ]
    },
    "scripts-descriptions": {
        "lint": "Run PHP CodeSniffer to check coding standards",
        "lint:fix": "Run PHP Code Beautifier to fix coding standards issues",
        "test": "Run PHPUnit tests",
        "test:coverage": "Run PHPUnit tests with coverage report",
        "security": "Run Psalm security analysis",
        "check-all": "Run all quality checks (lint, test, security)"
    }
}
